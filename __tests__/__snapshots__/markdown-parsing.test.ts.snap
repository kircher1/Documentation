        children: ["If creating and maintaining a mask is not practical, then you can disable the auto pointer capture on the HtmlMesh using ", _jsxDEV(_components.code, {
          children: "disableAutomaticPointerCapture"
        }, undefined, false, {
          fileName: "<source.js>",
